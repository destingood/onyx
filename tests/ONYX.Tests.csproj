    <Compile Include="..\src\IntegriteMemoire.cs" />
    <Compile Include="..\src\ReflexJeux.cs" />
    <Compile Include="..\src\CoherenceFps.cs" />
    <Compile Include="..\src\JournalJeu.cs" />
    <Compile Include="..\src\ListeSouhaits.cs" />
    <Compile Include="..\src\ReglagesFortnite.cs" />
    <Compile Include="..\src\ReglagesCyberpunk.cs" />
    <Compile Include="..\src\ReglagesCod.cs" />
    <Compile Include="..\src\SuccesSteam.cs" />
    <Compile Include="..\src\ClavierJeu.cs" />
    <Compile Include="..\src\ObjectifFps.cs" />
    <Compile Include="..\src\BilanJeu.cs" />
    <Compile Include="..\src\Manette.cs" />
