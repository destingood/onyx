    <Compile Include="..\src\ModePresentation.cs" />
    <!-- Modèle du catalogue (Tweak, Cat, Risque, NiveauPreuve) : la règle « Sûr » se teste sur le vrai type. -->
    <Compile Include="..\src\Model.cs" />
    <!-- Bons plans et Actus : modèle, sources, suivi, flux (purs). Le réseau vit dans OffresReseau.cs. -->
    <Compile Include="..\src\Offres.cs" />
