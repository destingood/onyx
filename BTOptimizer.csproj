<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SDK Windows 10 ciblé pour l'OCR intégré (Windows.Media.Ocr) de la base de connaissances. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BTOptimizer</AssemblyName>
    <RootNamespace>BTOptimizer</RootNamespace>

    <!-- On garde nos attributs [assembly:] manuels (Program.cs) et notre style C# 5. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationIcon>src\app.ico</ApplicationIcon>

    <!-- Prise en charge du DPI : WinForms exige de la déclarer ici plutôt que dans le manifeste
         (WFO0003). SystemAware = strict équivalent de l'ancien <dpiAware>true</dpiAware>, donc
         AUCUN changement de rendu. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>

    <!-- Seuls les .cs de src\ sont du code applicatif. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>

    <!-- Projet cible Windows : les APIs Windows-only sont attendues. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Assets FPSDoctor (mascotte, badges) embarques comme ressources. -->
  <ItemGroup>
    <EmbeddedResource Include="src\assets\*.png">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Polices officielles FPS Doctor (Ubuntu / Inter / Garet) embarquees. -->
    <EmbeddedResource Include="src\assets\fonts\*.ttf;src\assets\fonts\*.otf">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.4" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <!-- Extraction de texte des PDF pour la base de connaissances (100 % managé, MIT). -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

</Project>
