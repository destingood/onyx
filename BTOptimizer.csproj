<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BTOptimizer</AssemblyName>
    <RootNamespace>BTOptimizer</RootNamespace>

    <!-- On garde nos attributs [assembly:] manuels (Program.cs) et notre style C# 5. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationIcon>src\app.ico</ApplicationIcon>

    <!-- Seuls les .cs de src\ sont du code applicatif. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>

    <!-- CA1416 : projet cible Windows, les APIs Windows-only sont attendues.
         WFO0003 : le DPI est déclaré volontairement dans app.manifest (dpiAware=true,
         DPI système) — cohérent avec les fenêtres à disposition pixel-perfect (SetBounds
         absolus) et avec le manifeste déjà requis (élévation admin + common controls).
         Migrer vers ApplicationHighDpiMode changerait le point de config sans bénéfice ici. -->
    <NoWarn>CA1416;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.4" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
